const fs = require('fs');
const path = require('path');

// Fonctions pour lire/écrire les fichiers JSON
function readJSON(filePath) {
  try {
    if (!fs.existsSync(filePath)) return [];
    const data = fs.readFileSync(filePath, 'utf-8');
    return JSON.parse(data);
  } catch (e) {
    console.error(`❌ Erreur lecture JSON (${filePath}):`, e.message);
    return [];
  }
}

function writeJSON(filePath, data) {
  try {
    fs.writeFileSync(filePath, JSON.stringify(data, null, 2));
    return true;
  } catch (e) {
    console.error(`❌ Erreur écriture JSON (${filePath}):`, e.message);
    return false;
  }
}

// Chemins des fichiers JSON
const PATHS = {
  quizz: path.join(__dirname, '../data/quizz.json'),
  quizz_image: path.join(__dirname, '../data/quizz_image.json'),
  users: path.join(__dirname, '../data/users.json'),
  battle: path.join(__dirname, '../data/battle.json')
};

module.exports = {
  name: 'quiz',
  category: 'JEUX',
  description: 'Lancer un quiz interactif avec configuration personnalisée',
  allowedForAll: true,
  execute,
  handleConfigResponse,
  handleQuizAnswer
};
  
  async execute(conn, m, args) {
    try {
      // Vérifier s'il y a déjà un quiz en cours dans ce chat
      if (!global.quizSessions) {
        global.quizSessions = new Map();
      }
      
      const existingSession = global.quizSessions.get(m.chat);
      if (existingSession && existingSession.status === 'configuring') {
        return conn.sendMessage(m.chat, {
          text: `⚠️ *Configuration en cours*\n\nUn quiz est déjà en cours de configuration dans ce chat.\nTerminez la configuration actuelle ou tapez *!quiz stop* pour annuler.`
        }, { quoted: m });
      }
      
      // Commande pour arrêter la configuration
      if (args[0] === 'stop') {
        global.quizSessions.delete(m.chat);
        return conn.sendMessage(m.chat, {
          text: `🛑 *Configuration annulée*\n\nLa configuration du quiz a été annulée.\nTapez *!quiz* pour recommencer.`
        }, { quoted: m });
      }
      
      // Initialiser une nouvelle session de quiz
      const session = {
        chatId: m.chat,
        creator: m.sender,
        status: 'configuring',
        step: 1,
        config: {
          type: null,
          questionCount: null,
          timeLimit: null,
          moderator: null,
          difficulty: null,
          category: null
        },
        startTime: Date.now()
      };
      
      global.quizSessions.set(m.chat, session);
      
      // Démarrer la configuration - Étape 1
      await showStep1(conn, m);
      
    } catch (error) {
      console.error('❌ Erreur quiz:', error);
      await conn.sendMessage(m.chat, {
        text: `❌ *Erreur*\n\nUne erreur s'est produite lors du lancement du quiz.\nRéessayez dans quelques instants.\n\n*Erreur:* ${error.message}`
      }, { quoted: m });
    }
  }
};

