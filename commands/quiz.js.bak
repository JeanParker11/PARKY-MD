// ÉTAPE 6/6 - Confirmation et lancement
async function showStep6(conn, m) {
  const session = global.quizSessions.get(m.chat);
  const config = session.config;
  
  // Mapper les valeurs pour l'affichage
  const typeMap = { 1: "Image 🌌", 2: "Texte 📚", 3: "Multivers 💥" };
  const countMap = { 1: "3 questions ⚡", 2: "5 questions 🎯", 3: "10 questions 🔥" };
  const timeMap = { 1: "15 secondes ⚡", 2: "30 secondes 🎯", 3: "60 secondes 🤔", 4: "Illimité ♾️" };
  const modMap = { 1: "Auto-Modéré 🤖", 2: "Admin Modéré 👑", 3: "Créateur Modéré 🎯", 4: "Libre 🌊" };
  const diffMap = { 1: "Débutant 🌱", 2: "Intermédiaire 🎯", 3: "Expert 🔥", 4: "Mélangé 🌀" };
  
  const message = `*🎮 CONFIGURATION QUIZ - ÉTAPE 6/6*\n\n*Récapitulatif de votre Quiz :*\n\n🎯 *Type :* ${typeMap[config.type]}\n🔢 *Questions :* ${typeof config.questionCount === 'number' ? config.questionCount + ' questions 📝' : countMap[config.questionCount]}\n⏰ *Temps :* ${timeMap[config.timeLimit]}\n👮 *Modération :* ${modMap[config.moderator]}\n🎚️ *Difficulté :* ${diffMap[config.difficulty]}\n\n*Prêt à commencer ?*\n\n✅ *OUI* - Lancer le quiz !\n❌ *NON* - Annuler la configuration\n\n*Répondez OUI ou NON*\n*Tapez '!quiz stop' pour annuler*`;
  
  await conn.sendMessage(m.chat, {
    text: message,
    contextInfo: {
      externalAdReply: {
        title: "🎮 Configuration Quiz - ÉTAPE 6/6",
        body: "Confirmation et lancement",
        thumbnailUrl: global.menuImageUrl,
        sourceUrl: global.SITE_URL,
        mediaType: 1,
        renderLargerThumbnail: true
      }
    }
  }, { quoted: m });
}

// ... [le reste du code reste inchangé jusqu'à showNextQuestion]

// Afficher la question suivante
async function showNextQuestion(conn, chatId, session) {
  try {
    if (session.currentQuestion >= session.questions.length) {
      await endQuiz(conn, chatId, session);
      return;
    }
    
    const question = session.questions[session.currentQuestion];
    const questionNum = session.currentQuestion + 1;
    const totalQuestions = session.questions.length;
    
    session.questionStartTime = Date.now();
    
    // Préparer le message de la question
    let questionMessage = `*🎮 QUIZ EN COURS - Question ${questionNum}/${totalQuestions}*\n\n❓ *${question.question}*\n\n🅰️ ${question.options.a}\n🅱️ ${question.options.b}\n🅲️ ${question.options.c}\n🅳️ ${question.options.d}`;
    
    // Ajouter info temps si limité
    const timeMap = { 1: 15, 2: 30, 3: 60, 4: 0 };
    const timeLimit = timeMap[session.config.timeLimit];
    if (timeLimit > 0) {
      questionMessage += `\n\n⏰ *Temps limité :* ${timeLimit} secondes`;
    }
    
    questionMessage += `\n\n*Répondez avec a, b, c ou d*`;
    
    if (question.proposedBy) {
      questionMessage += `\n*Proposé par :* ${question.proposedBy}`;
    }
    
    // Envoyer la question
    if (question.imageUrl) {
      await conn.sendMessage(chatId, {
        image: { url: question.imageUrl },
        caption: questionMessage
      });
    } else {
      await conn.sendMessage(chatId, {
        text: questionMessage,
        contextInfo: {
          externalAdReply: {
            title: `🎮 Question ${questionNum}/${totalQuestions}`,
            body: "Quiz en cours - Répondez rapidement !",
            thumbnailUrl: global.menuImageUrl,
            sourceUrl: global.SITE_URL,
            mediaType: 1
          }
        }
      });
    }
    
    // Timer pour la question si temps limité
    if (timeLimit > 0) {
      setTimeout(() => {
        const currentSession = global.quizSessions.get(chatId);
        if (currentSession && currentSession.currentQuestion === session.currentQuestion) {
          nextQuestion(conn, chatId, currentSession, true);
        }
      }, timeLimit * 1000);
    }
    
  } catch (error) {
    console.error('❌ Erreur affichage question:', error);
  }
}

// ... [le reste du code reste inchangé jusqu'à endQuiz]

async function endQuiz(conn, chatId, session) {
  try {
    // Calculer les scores finaux
    const finalScores = [];
    for (const [userId, userData] of session.participants.entries()) {
      finalScores.push({
        userId,
        name: userData.name,
        score: userData.score,
        correctAnswers: userData.correctAnswers
      });
    }
    
    // Trier par score
    finalScores.sort((a, b) => b.score - a.score);
    
    // Sauvegarder les scores dans la base de données
    const users = readJSON(PATHS.users);
    for (const participant of finalScores) {
      if (!users[participant.userId]) {
        users[participant.userId] = { score: 0 };
      }
      users[participant.userId].score += participant.score;
    }
    writeJSON(PATHS.users, users);
    
    // Message de fin
    let endMessage = `*🏁 QUIZ TERMINÉ !*\n\n*Résultats finaux :*\n\n`;
    
    if (finalScores.length > 0) {
      const medals = ['🥇', '🥈', '🥉'];
      finalScores.forEach((participant, index) => {
        const medal = medals[index] || '🏆';
        endMessage += `${medal} *${participant.name}*\n   ${participant.score} points (${participant.correctAnswers}/${session.questions.length} bonnes réponses)\n\n`;
      });
    } else {
      endMessage += `😅 *Aucun participant n'a répondu !*\n\n`;
    }
    
    endMessage += `*Statistiques :*\n`;
    endMessage += `🔢 Questions posées : ${session.questions.length}\n`;
    endMessage += `👥 Participants : ${session.participants.size}\n`;
    endMessage += `⏱️ Durée totale : ${Math.round((Date.now() - session.startTime) / 1000)} secondes\n\n`;
    endMessage += `🎮 *Tapez '!quiz' pour un nouveau quiz !*`;
    
    await conn.sendMessage(chatId, {
      text: endMessage,
      contextInfo: {
        externalAdReply: {
          title: "🏁 Quiz Terminé !",
          body: `${finalScores.length} participants - ${session.questions.length} questions`,
          thumbnailUrl: global.menuImageUrl,
          sourceUrl: global.SITE_URL,
          mediaType: 1,
          renderLargerThumbnail: true
        }
      }
    });
    
    // Nettoyer la session
    global.quizSessions.delete(chatId);
    
  } catch (error) {
    console.error('❌ Erreur fin de quiz:', error);
    global.quizSessions.delete(chatId);
  }
}

// Gestionnaire des réponses au quiz
async function handleQuizAnswer(conn, m) {
  if (!global.quizSessions) return false;
  
  const session = global.quizSessions.get(m.chat);
  if (!session || session.status !== 'active') return false;
  
  const answer = m.text?.toLowerCase().trim();
  if (!['a', 'b', 'c', 'd'].includes(answer)) return false;
  
  try {
    // Initialiser le participant s'il n'existe pas
    if (!session.participants.has(m.sender)) {
      session.participants.set(m.sender, {
        name: 'Joueur',
        score: 0,
        correctAnswers: 0,
        answers: {}
      });
    }
    
    const participant = session.participants.get(m.sender);
    
    // Vérifier si déjà répondu à cette question
    if (participant.answers[session.currentQuestion]) {
      await conn.sendMessage(m.chat, {
        text: `❌ Vous avez déjà répondu à cette question !`
      }, { quoted: m });
      return true;
    }
    
    // Enregistrer la réponse
    const question = session.questions[session.currentQuestion];
    const isCorrect = answer === question.answer;
    const responseTime = Date.now() - session.questionStartTime;
    
    participant.answers[session.currentQuestion] = {
      answer,
      isCorrect,
      responseTime
    };
    
    if (isCorrect) {
      participant.score += 10;
      participant.correctAnswers++;
      
      await conn.sendMessage(m.chat, {
        text: `✅ **Bonne réponse !** +10 points`
      }, { quoted: m });
    } else {
      await conn.sendMessage(m.chat, {
        text: `❌ **Mauvaise réponse !** La bonne réponse sera révélée.`
      }, { quoted: m });
    }
    
    return true;
    
  } catch (error) {
    console.error('❌ Erreur gestion réponse quiz:', error);
    return false;
  }
}

// Exporter les gestionnaires
module.exports.handleConfigResponse = handleConfigResponse;
module.exports.handleQuizAnswer = handleQuizAnswer;